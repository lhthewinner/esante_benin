# -------------------------------------------------------------
# E-Santé Bénin — Modèle de Configuration (.env.example)
# Copiez ce fichier vers .env et renseignez vos clés réelles
# -------------------------------------------------------------

# --- Clés API IA ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Modèles et Modes Opératoires ---
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=whisper-large-v3
WHISPER_MODEL=small
UTILISER_GROQ_CHAT=True
UTILISER_GROQ_WHISPER=True
SESSION_EXPIRATION_MINUTES=120

# --- Bot Telegram ---
TELEGRAM_TOKEN=your_telegram_bot_token_here
API_URL=http://localhost:8000

# --- Base de Données MySQL (WAMP) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=esante_benin

# --- Cache & Sessions (Redis optionnel, fallback automatique en mémoire) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentification Personnel Soignant (Dashboard) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password
DASHBOARD_SECRET_KEY=generate_a_random_secret_key
